# ==============================================================================
# B-LINE INITIAL USABLE RELEASE V1 RC1 — NON-SECRET CONFIGURATION TEMPLATE
# Release ID: B_LINE_INITIAL_USABLE_RELEASE_V1_RC1
# Startup Contract: SERIALIZED_SINGLE_RUNTIME_INITIALIZER
# Canonical Startup Command:
#   uvicorn btc_quant_agent.api:app --host 127.0.0.1 --port 8787 --workers 1
# ==============================================================================
# SECURITY & AUTHORITY NOTICE:
# - Never commit real secrets, API keys, or tokens into Git or evidence files.
# - Real-money write authority is NONE. LIVE execution mode is unavailable.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Config & Persistence Paths
# ------------------------------------------------------------------------------
BTC_QUANT_CONFIG=./configs/default.toml
BTC_QUANT_DB_PATH=./var/quant.db
BTC_QUANT_LIVE_V1_DB_PATH=./var/live_v1.db
BTC_QUANT_API_TOKEN=

# ------------------------------------------------------------------------------
# 2. Live V1 Mode, Feature Flags & Safety Authority Locks
# ------------------------------------------------------------------------------
# Set BTC_QUANT_LIVE_V1_RUNTIME_ENABLED=true for canonical B4_RUNTIME service mode.
BTC_QUANT_LIVE_V1_RUNTIME_ENABLED=true
BTC_QUANT_LIVE_V1_ENABLED=false

# Supported modes: DRY_RUN | TESTNET (LIVE is unavailable and rejected at startup)
BTC_QUANT_LIVE_V1_EXECUTION_MODE=DRY_RUN
# Must be true when BTC_QUANT_LIVE_V1_EXECUTION_MODE=TESTNET
BTC_QUANT_LIVE_V1_TESTNET_EXECUTION_ENABLED=false

# Immutable RC1 Safety Authority Locks
REAL_FUNDS_WRITE_AUTHORITY=NONE
LIVE_APPROVAL_ONLY=NOT_AUTHORIZED
AUTONOMOUS_LIVE=FORBIDDEN

# ------------------------------------------------------------------------------
# 3. Public Market Data & Runtime Polling Intervals
# ------------------------------------------------------------------------------
BTC_QUANT_LIVE_V1_SYMBOL=BTCUSDT
BTC_QUANT_LIVE_V1_ACCOUNT_ID=DEFAULT_ACCOUNT
BTC_QUANT_LIVE_V1_WS_URL=wss://fstream.binance.com
# Account REST reconciliation interval in seconds (must be between 30 and 60)
BTC_QUANT_LIVE_V1_REST_RECONCILE_SECONDS=30
BTC_QUANT_LIVE_V1_POSITION_POLL_SECONDS=5
BTC_QUANT_LIVE_V1_OUTBOX_POLL_SECONDS=5

# ------------------------------------------------------------------------------
# 4. Analysis Backend & Decision Risk Identifiers
# ------------------------------------------------------------------------------
# Primary analysis backend (OpenAI Responses API)
BTC_QUANT_LIVE_RESPONSES_MODEL=gpt-5.4
OPENAI_API_KEY=

# Secondary review backend (Codex CLI sandbox)
BTC_QUANT_LIVE_CODEX_ENABLED=false
BTC_QUANT_LIVE_CODEX_MODEL=gpt-5.3-codex-spark

# Analysis timeout (seconds, > 0) and tactical case TTL (milliseconds, > 0)
BTC_QUANT_LIVE_ANALYSIS_TIMEOUT=60
BTC_QUANT_LIVE_CASE_TTL_MS=120000
# Optional JSON override for RiskPolicyV1 (leave unset for default policy)
# BTC_QUANT_LIVE_RISK_POLICY_JSON={"max_leverage":3,"max_notional_usdt":100.0}

# ------------------------------------------------------------------------------
# 5. Feishu Approval & Notification Configuration
# ------------------------------------------------------------------------------
# Outbound interactive card delivery (all three must be set together or all left empty)
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_RECEIVE_ID=
FEISHU_RECEIVE_ID_TYPE=chat_id

# Inbound callback authentication & approver allowlist (comma-separated open_ids)
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
FEISHU_APPROVER_OPEN_IDS=

# Optional MarketWatch webhook notification variables
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 6. Binance Futures Testnet Credentials & Endpoints (TESTNET Mode Only)
# ------------------------------------------------------------------------------
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
BINANCE_TESTNET_FAPI_BASE_URL=https://testnet.binancefuture.com
BINANCE_TESTNET_WS_BASE_URL=wss://stream.binancefuture.com/ws
