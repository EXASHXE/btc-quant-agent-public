{
  "$defs": {
    "Opportunity": {
      "additionalProperties": false,
      "description": "Ex-ante contract only; a caller cannot activate another strategy or assert a fill.",
      "properties": {
        "account_status": {
          "default": "UNKNOWN",
          "enum": [
            "UNKNOWN",
            "VETO",
            "NOT_REQUESTED"
          ],
          "title": "Account Status",
          "type": "string"
        },
        "atr_buffer": {
          "exclusiveMinimum": 0,
          "title": "Atr Buffer",
          "type": "number"
        },
        "available_ms": {
          "title": "Available Ms",
          "type": "integer"
        },
        "cost_assumption": {
          "minLength": 1,
          "title": "Cost Assumption",
          "type": "string"
        },
        "direction": {
          "enum": [
            "LONG",
            "SHORT"
          ],
          "title": "Direction",
          "type": "string"
        },
        "entry_region": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Entry Region",
          "type": "array"
        },
        "execution_buffer": {
          "exclusiveMinimum": 0,
          "title": "Execution Buffer",
          "type": "number"
        },
        "expires_ms": {
          "title": "Expires Ms",
          "type": "integer"
        },
        "holding_hours": {
          "default": 24,
          "maximum": 120,
          "minimum": 8,
          "title": "Holding Hours",
          "type": "integer"
        },
        "planned_after_cost_r": {
          "exclusiveMinimum": 0,
          "title": "Planned After Cost R",
          "type": "number"
        },
        "planned_cost_per_unit": {
          "minimum": 0,
          "title": "Planned Cost Per Unit",
          "type": "number"
        },
        "regime": {
          "enum": [
            "TREND_UP",
            "TREND_DOWN"
          ],
          "title": "Regime",
          "type": "string"
        },
        "review_deadline_ms": {
          "title": "Review Deadline Ms",
          "type": "integer"
        },
        "risk_factors": {
          "default": [
            "PLANNED_PAYOFF_IS_NOT_EXECUTABLE_OR_REALIZED"
          ],
          "items": {
            "type": "string"
          },
          "title": "Risk Factors",
          "type": "array"
        },
        "setup_close_ms": {
          "title": "Setup Close Ms",
          "type": "integer"
        },
        "strategy": {
          "const": "trend_pullback",
          "default": "trend_pullback",
          "title": "Strategy",
          "type": "string"
        },
        "structural_invalidation": {
          "exclusiveMinimum": 0,
          "title": "Structural Invalidation",
          "type": "number"
        },
        "structural_observed_ms": {
          "title": "Structural Observed Ms",
          "type": "integer"
        },
        "symbol": {
          "enum": [
            "BTCUSDT",
            "ETHUSDT",
            "SOLUSDT"
          ],
          "title": "Symbol",
          "type": "string"
        },
        "target_zones": {
          "items": {
            "type": "number"
          },
          "title": "Target Zones",
          "type": "array"
        }
      },
      "required": [
        "symbol",
        "direction",
        "regime",
        "setup_close_ms",
        "available_ms",
        "structural_observed_ms",
        "entry_region",
        "structural_invalidation",
        "atr_buffer",
        "execution_buffer",
        "target_zones",
        "planned_after_cost_r",
        "planned_cost_per_unit",
        "cost_assumption",
        "review_deadline_ms",
        "expires_ms"
      ],
      "title": "Opportunity",
      "type": "object"
    },
    "State": {
      "enum": [
        "NO_SETUP",
        "WATCH",
        "READY_FOR_REVIEW",
        "ENTRY_ZONE_ACTIVE",
        "MISSED_OR_NO_CHASE",
        "INVALIDATED",
        "EXPIRED",
        "DATA_UNAVAILABLE",
        "SOURCE_BLOCKED",
        "ACCOUNT_UNKNOWN",
        "VETO"
      ],
      "title": "State",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "actionability": {
      "enum": [
        "NOT_ACTIONABLE",
        "REVIEW_ONLY"
      ],
      "title": "Actionability",
      "type": "string"
    },
    "bar_prefix_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Bar Prefix Hash",
      "type": "string"
    },
    "decision_ms": {
      "title": "Decision Ms",
      "type": "integer"
    },
    "evidence_tier": {
      "const": "OFFLINE_CONTRACT_ONLY",
      "default": "OFFLINE_CONTRACT_ONLY",
      "title": "Evidence Tier",
      "type": "string"
    },
    "integration_status": {
      "const": "LT_B_INTEGRATION_PENDING",
      "default": "LT_B_INTEGRATION_PENDING",
      "title": "Integration Status",
      "type": "string"
    },
    "next_review_ms": {
      "title": "Next Review Ms",
      "type": "integer"
    },
    "opportunity": {
      "anyOf": [
        {
          "$ref": "#/$defs/Opportunity"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "product_version": {
      "const": "V070_SWING_ADVISORY_V1",
      "default": "V070_SWING_ADVISORY_V1",
      "title": "Product Version",
      "type": "string"
    },
    "reasons": {
      "items": {
        "type": "string"
      },
      "title": "Reasons",
      "type": "array"
    },
    "schema_version": {
      "const": "V070_SWING_SNAPSHOT_V1",
      "default": "V070_SWING_SNAPSHOT_V1",
      "title": "Schema Version",
      "type": "string"
    },
    "setup_status": {
      "enum": [
        "NO_SETUP",
        "CONTRACT_CANDIDATE"
      ],
      "title": "Setup Status",
      "type": "string"
    },
    "shadow_qualified": {
      "const": false,
      "default": false,
      "title": "Shadow Qualified",
      "type": "boolean"
    },
    "source_qualified": {
      "const": false,
      "default": false,
      "title": "Source Qualified",
      "type": "boolean"
    },
    "state": {
      "$ref": "#/$defs/State"
    },
    "symbol": {
      "enum": [
        "BTCUSDT",
        "ETHUSDT",
        "SOLUSDT"
      ],
      "title": "Symbol",
      "type": "string"
    },
    "trigger_close_ms": {
      "title": "Trigger Close Ms",
      "type": "integer"
    }
  },
  "required": [
    "state",
    "setup_status",
    "actionability",
    "symbol",
    "decision_ms",
    "trigger_close_ms",
    "next_review_ms",
    "bar_prefix_hash",
    "reasons"
  ],
  "title": "AdvisorySnapshot",
  "type": "object"
}
