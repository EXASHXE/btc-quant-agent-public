# BTC Quant Agent Network & Proxy Environment Template
# ==============================================================================
# IMPORTANT FOR BINANCE ACCESS:
# Do NOT route through US IP addresses (causes HTTP 451: Unavailable For Legal Reasons).
# Ensure egress traffic originates from supported regions (e.g. EU, Singapore, Tokyo).
# ==============================================================================

# If behind a forward proxy:
# HTTP_PROXY="http://proxy-host:7890"
# HTTPS_PROXY="http://proxy-host:7890"
# NO_PROXY="localhost,127.0.0.1"

# Production flags:
PYTHONUNBUFFERED="1"
BTC_QUANT_TRIGGER_SOURCE="SCHEDULED"
