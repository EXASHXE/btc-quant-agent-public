[Unit]
Description=BTC Quant Agent data-only forward evidence health check
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/workspace/project/Quant-agent
ExecStart=/root/workspace/project/Quant-agent/.venv/bin/quantctl forward-evidence health
Environment=PYTHONUNBUFFERED=1
SuccessExitStatus=0 2
PrivateTmp=true
NoNewPrivileges=true
