[Unit]
Description=BTC Quant Agent H39 blind forward validation daily scheduled accumulation
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/workspace/project/Quant-agent
ExecStart=/root/workspace/project/Quant-agent/.venv/bin/quantctl h39 scheduled-accumulate --only-finalized
Nice=15
IOSchedulingClass=best-effort
IOSchedulingPriority=7
MemoryMax=2G
CPUQuota=80%
TimeoutStartSec=1800s
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-%h/.config/btc-quant-agent/network.env
PrivateTmp=true
NoNewPrivileges=true