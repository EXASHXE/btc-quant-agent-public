[Unit]
Description=BTC Quant Agent forward derivatives PIT snapshot
Documentation=file:/root/workspace/project/Quant-agent/docs/FORWARD_DERIVATIVES_OPERATIONS.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/workspace/project/Quant-agent
ExecStart=/root/workspace/project/Quant-agent/.venv/bin/quantctl derivatives collect-once --store /root/workspace/project/Quant-agent/data/forward/BTCUSDT/derivatives.sqlite3 --symbol BTCUSDT
Environment=PYTHONUNBUFFERED=1
PrivateTmp=true
NoNewPrivileges=true
