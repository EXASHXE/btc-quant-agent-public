[Unit]
Description=BTC Quant Agent directionless opportunity forward observation
Documentation=file:/root/workspace/project/Quant-agent/deliverables/v0.3.20/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/workspace/project/Quant-agent
ExecStart=/root/workspace/project/Quant-agent/.venv/bin/quantctl opportunity-forward collect-once --store /root/workspace/project/Quant-agent/data/forward/BTCUSDT/opportunity_shadow.sqlite3 --campaign /root/workspace/project/Quant-agent/configs/forward/v0.3.20_opportunity_successor_campaign.json
Environment=PYTHONUNBUFFERED=1
Environment=BTC_QUANT_TRIGGER_SOURCE=SCHEDULED
EnvironmentFile=-%h/.config/btc-quant-agent/network.env
SuccessExitStatus=0 2
PrivateTmp=true
NoNewPrivileges=true
