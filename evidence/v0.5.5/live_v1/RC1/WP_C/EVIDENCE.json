  "fusion_trigger_matrix": {
    "triggers": [
      {
        "name": "low_confidence",
        "condition": "primary.confidence < confidence_threshold (0.7)",
        "reason": "LOW_CONFIDENCE",
        "requires_secondary": true,
        "requires_manual_if_secondary_unavailable": true
      },
      {
        "name": "high_exposure",
        "condition": "max(symbol_exposure, portfolio_exposure) / equity >= high_exposure_fraction (0.25)",
        "reason": "HIGH_EXPOSURE",
        "requires_secondary": true,
        "requires_manual_if_secondary_unavailable": true
      },
      {
        "name": "add_action",
        "condition": "primary.action == 'ADD'",
        "reason": "ADD_REVIEW",
        "requires_secondary": true,
        "requires_manual_if_secondary_unavailable": true
      },
      {
        "name": "reversal_action",
        "condition": "(case.direction == 'LONG' and primary.action == 'OPEN_SHORT') or (case.direction == 'SHORT' and primary.action == 'OPEN_LONG')",
        "reason": "REVERSE_OR_CLOSE_ACTION",
        "requires_secondary": true,
        "requires_manual_if_secondary_unavailable": true
      },
      {
        "name": "close_sensitive_action",
        "condition": "primary.action in ('CLOSE', 'REDUCE', 'TAKE_PARTIAL')",
        "reason": "REVERSE_OR_CLOSE_ACTION",
        "requires_secondary": true,
        "requires_manual_if_secondary_unavailable": true
      },
      {
        "name": "strategy_data_disagreement",
        "condition": "primary.strategy_data_disagreement == True",
        "reason": "STRATEGY_DATA_DISAGREEMENT",
        "requires_secondary": true,
        "requires_manual_if_secondary_unavailable": true
      },
      {
        "name": "primary_requests_secondary_review",
        "condition": "primary.requires_secondary_review == True",
        "reason": "SECONDARY_REVIEW_REQUESTED",
        "requires_secondary": true,
        "requires_manual_if_secondary_unavailable": true
      },
      {
        "name": "primary_requests_manual_review",
        "condition": "primary.requires_manual_review == True",
        "reason": "PRIMARY_REVIEW_REQUESTED",
        "requires_secondary": true,
        "requires_manual_if_secondary_unavailable": true
      },
      {
        "name": "manual_codex_review_request",
        "condition": "manual_codex_request == True",
        "reason": "MANUAL_CODEX_REQUEST",
        "requires_secondary": true,
        "requires_manual_if_secondary_unavailable": true
      }
    ],
    "hard_disagreements": [
      {
        "field": "action",
        "condition": "primary.action != secondary.action",
        "outcome_reasons": ["MODEL_DISAGREEMENT", "MANUAL_REVIEW_REQUIRED"],
        "risk_modifier": "BLOCK",
        "requires_manual_review": true
      },
      {
        "field": "risk_modifier",
        "condition": "primary.risk_modifier != secondary.risk_modifier",
        "outcome_reasons": ["MODEL_DISAGREEMENT", "MANUAL_REVIEW_REQUIRED"],
        "risk_modifier": "BLOCK",
        "requires_manual_review": true
      },
      {
        "field": "entry_quality",
        "condition": "primary.entry_quality != secondary.entry_quality",
        "outcome_reasons": ["MODEL_DISAGREEMENT", "MANUAL_REVIEW_REQUIRED"],
        "risk_modifier": "BLOCK",
        "requires_manual_review": true
      },
      {
        "field": "thesis_strength",
        "condition": "abs(primary.thesis_strength - secondary.thesis_strength) >= 0.3",
        "outcome_reasons": ["MODEL_DISAGREEMENT", "MANUAL_REVIEW_REQUIRED"],
        "risk_modifier": "BLOCK",
        "requires_manual_review": true
      }
    ],
