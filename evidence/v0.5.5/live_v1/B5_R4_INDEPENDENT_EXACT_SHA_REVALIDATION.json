  "findings": [
    {
      "id": "B5R4-01",
      "severity": "BLOCKER",
      "title": "PENDING recovery promotes protection without exact-ID confirmation",
      "source": [
        "src/btc_quant_agent/execution/backend.py:598",
        "src/btc_quant_agent/execution/backend.py:618",
        "src/btc_quant_agent/execution/backend.py:675"
      ],
      "reproduction": "Protective POST returns owned-stop; exact-ID query fails; owner is PENDING_CONFIRMATION. Restart with an otherwise matching openAlgoOrders listing while exact-ID query remains unavailable. Recovery returns owned-stop and writes ACTIVE without retrying query_protective_order. A listing with algoStatus omitted is also accepted via implicit NEW.",
      "evidence": [
        "test_independent_protection_contract.py::test_pending_restart_requires_successful_exact_id_query (2 failing safety assertions)",
        "protection/test_independent_protection_probe.py::test_pending_restart_promotes_from_open_list_without_exact_query (2 observed-behavior cases)"
      ],
      "impact": "Violates the mandatory authoritative exact-ID query before atomic ACTIVE invariant. Aggregate listing becomes installation authority after an uncertain placement.",
      "limits": "No duplicate placement was observed, and the kill switch remains latched from the initial uncertainty. No network or real-money write was exercised."
    },
    {
      "id": "B5R4-02",
      "severity": "HIGH",
      "title": "Confirmation ignores explicitly different protective execution settings",
      "source": [
        "src/btc_quant_agent/execution/backend.py:649",
        "src/btc_quant_agent/execution/backend.py:691"
      ],
      "reproduction": "POST requests workingType=MARK_PRICE, priceProtect=TRUE, closePosition=false, algoType=CONDITIONAL. Exact-ID query returning CONTRACT_PRICE, priceProtect=false, closePosition=true, or algoType=OTHER is accepted and persisted ACTIVE.",
      "evidence": [
        "test_independent_protection_contract.py::test_exact_confirmation_must_preserve_submitted_stop_semantics (4 failing safety assertions)"
      ],
      "impact": "Matching numeric trigger price alone does not establish the requested stop trigger source or full execution contract.",
      "limits": "Fake responses demonstrate missing validation, not that Binance normally changes submitted fields."
    },
    {
      "id": "B5R4-03",
      "severity": "HIGH",
      "title": "Flat reconciliation discards unresolved remote stop identity",
      "source": [
        "src/btc_quant_agent/execution/backend.py:606",
        "src/btc_quant_agent/execution/protection.py:240"
      ],
      "reproduction": "After POST success/query uncertainty leaves PENDING_CONFIRMATION with exchange_id, a flat position and empty aggregate listing cause RELEASED and exchange_id=NULL without exact-ID absence or cancellation confirmation.",
      "evidence": [
        "test_independent_protection_contract.py::test_flat_position_must_retain_unresolved_exact_stop_identity"
      ],
      "impact": "Durable exact stop authority is lost under uncertainty; later reconciliation ignores the RELEASED owner.",
      "limits": "The position is flat, kill remains latched, and orphan-stop impact requires a stale/inconsistent listing plus later risk reenablement. No immediate excess exposure or duplicate submit was proved."
    },
