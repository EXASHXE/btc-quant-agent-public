  "formula_definitions": {
    "CLOSED_RETEST": "4h EMA directionalordering at breakout and confirmation for explicitprice-onlyshadow; normative timing ambiguity remainsnon-evaluable. 1h C breaks prior24hourhigh/low by>=.25ATR20_1h, signedbody>=.5ATR. Freezeboundary/ATR. Onlynext3closedhours: LONG LOW liesin[boundary-.25A,boundary+.25A],C>=boundary+.1A,C>O; SHORT HIGH inband,C<=boundary-.1A,C<O. Precedingwrongdirectionclose beyond.25A cancels. Firstconfirmation. Stopminlowbreakthroughconfirm-.25A/maxhigh+.25A. ConfirmationATRhour/C30..250bp; geometry ATR andgap use currentconfirmationhourATR, frozenbreakoutATR stopconstruction. Oneevent=side/breakouthour, firstattempt consumedincludinggapveto.",
    "FAILED_BREAKOUT": "SHORT current15mH>prior16HIGH+.25ATR20_15,C<priorHIGH-.10ATR20_15,C<O; LONG L<prior16LOW-.25ATR20_15,C>priorLOW+.10ATR20_15,C>O. Stop currentH+.25ATR15 orL-.25ATR15;hold8h.",
    "IMPULSE_COMPRESSION": "j=k-3 impulse signedbody>=1.5ATR20_15[j-1],range<=3frozenA; j+1,j+2ranges<=.75frozenA andhighlowcontainedimpulse. CurrentkC beyondtwo-compressionbarH/L by.10frozenA,signedbody>=.5frozenA,current4hC>EMA20>EMA50/mirror. Stop=C15-d*2ATR20_1h;hold24h.",
    "RANGE_EXPANSION": "15mC beyond prior16barHIGH/LOW,signedbody>=.5ATR20_15,volume>=1.25meanPREVIOUS20volumes,ER12_1h>=.25. Stop=C15-d*1.5ATR20_1h;hold8h.",
    "STRUCTURAL_CONTINUATION": "LONG closed4h C>EMA20>EMA50, EMA20[t]>EMA20[t-3], ER12_4h>=.35; SHORT mirrors. Closed1h C breaks prior3completehours high/low, signedbody>=.5ATR20_1h,range<=2ATR20_1h,abs(C1h-EMA20_4h)<=ATR20_4h. Stop=C1h-d*1.5ATR20_1h. ATR20_1h/C1h30..250bp. Hourdecisionclose+60s/fill+120s. New4hbar sinceprecedingentry.",
    "TREND_PULLBACK": "Current4h C>EMA20>EMA50/mirror,ER12_4h>=.25. LONG previous15mC<=previousEMA20_15, currentLOW<=currentEMA20_15,C>EMA20_15,C>O; SHORT mirrors. Stop=C15-d*1.5ATR20_1h;hold8h.",
    "challenger_common": "ATR20_1h/C15 15..250bp,60completed4h; eachone bidirectionalrule nottwo additionaltrials; nofit/parametergrid"
  },
