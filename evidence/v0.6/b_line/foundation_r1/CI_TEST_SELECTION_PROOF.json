  "first_push_fix_details": {
    "inherited_risk": "On first push of a new branch where github.event.before == '0'*40, the original planner evaluated 'base = HEAD^', which only examined the single top commit on the branch, silently omitting all earlier branch commits.",
    "resolution": "Resolved via explicitly verified merge-base against fetched immutable base v0.6 (8ecff4ec4b25bf73a35309689fd3ecfacc0d3399 / origin/v0.6 / base_ref), capturing the complete branch diff.",
    "fail_closed_guarantee": "If merge-base is missing, unfetched, or unresolvable, changed_paths returns None and classify fails closed to mode 'full' with reason 'unknown-base-fail-closed'."
  },
  "rename_and_delete_fix_details": {
    "inherited_risk": "Original planner diff used --diff-filter=ACMRT which excluded 'D' (deleted files), causing test deletions or file removals to pass silently as none.",
    "resolution": "Removed restrictive diff-filter to capture all changed, deleted, and renamed paths. If a test file is removed or renamed, classify detects that the file no longer exists on disk and fails closed to mode 'full'."
  },
